{
  "name": "sportsline-ecommerce",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:gateway && npm run build:users && npm run build:products && npm run build:orders && npm run build:categories && npm run build:order-items",
    "build:gateway": "nest build gateway",
    "build:users": "nest build users-service",
    "build:products": "nest build products-service",
    "build:orders": "nest build orders-service",
    "build:order-items": "nest build order-items-service",
    "build:categories": "nest build categories-service",
    "start": "nest start gateway --watch",
    "start:prod": "node dist/src/gateway/main",
    "start:debug": "nest start gateway --debug --watch",
    "start:all": "concurrently \"npm run start:users\" \"npm run start:products\" \"npm run start:orders\" \"npm run start:order-items\" \"npm run start:categories\" \"npm run start:gateway\"",
    "start:gateway": "nest start gateway --watch",
    "start:users": "nest start users-service --watch",
    "start:products": "nest start products-service --watch",
    "start:orders": "nest start orders-service --watch",
    "start:order-items": "nest start order-items-service --watch",
    "start:categories": "nest start categories-service --watch",
    "docker": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "db:psql": "docker exec -it sportsline-ecommerce-postgres-1 psql -U jeferson -d sportsline",
    "db:logs": "docker compose logs -f postgres",
    "seed": "timeout /t 10 /nobreak >nul && docker compose exec -T postgres psql -U jeferson -d sportsline -f /seed.sql",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
